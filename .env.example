# Copy this file to .env and fill in real values. .env is gitignored.

SFTP_HOST=
SFTP_PORT=22
SFTP_USER=

# Provide either a password or a private key path (key takes precedence if both are set).
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=

# Confirmed live path on the server (nginx docroot is the repo's out/ dir, not public/pdfs).
SFTP_REMOTE_DIR=/var/www/machon-hasulchan/out/pdfs

# Optional: local working folder to pull updated PDFs from before uploading (same filename only).
PDF_SOURCE_DIR=/home/bz/Desktop/aktualis/sua
